<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="Editar Produto">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="Descrição" FontSize="16" FontAttributes="Bold" />
            <Entry x:Name="txtDescricao" Placeholder="Descrição do produto" />

            <Label Text="Quantidade" FontSize="16" FontAttributes="Bold" />
            <Entry x:Name="txtQuantidade" Keyboard="Numeric" />

            <Label Text="Preço (R$)" FontSize="16" FontAttributes="Bold" />
            <Entry x:Name="txtPreco" Keyboard="Numeric" />

            <Button Text="Salvar Alterações"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontSize="18"
                    Margin="0,20,0,0"
                    Clicked="btnSalvar_Clicked" />

            <Button Text="Excluir Produto"
                    BackgroundColor="Red"
                    TextColor="White"
                    FontSize="18"
                    Clicked="btnExcluir_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>